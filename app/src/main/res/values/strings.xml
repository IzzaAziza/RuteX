    <!-- Tentang RuteX -->
    <string name="tentang_versi">Versi %1$s</string>
    <string name="tentang_deskripsi">RuteX adalah aplikasi perencana wisata Cirebon yang membantu menyusun rute kunjungan budaya, kuliner, alam, dan belanja dengan urutan yang efisien.</string>
    <string name="tentang_fitur_title">Fitur Utama</string>
    <string name="tentang_fitur_1">Rencana rute manual dengan destinasi pilihan sendiri</string>
    <string name="tentang_fitur_2">Rekomendasi rute dari preferensi perjalanan</string>
    <string name="tentang_fitur_3">Itinerary lengkap dengan jam tiba dan peta rute</string>
    <string name="tentang_fitur_4">Riwayat rencana yang tersimpan di perangkat</string>
    <string name="tentang_sumber_title">Sumber Data</string>
    <string name="tentang_sumber_isi">Data destinasi dan penyusunan rute berasal dari server RuteX (api.rutex.id). Peta menggunakan data © kontributor OpenStreetMap.</string>
    <string name="tentang_pengembang">Dikembangkan oleh Baiq Izza Aziza</string>

    <!-- Syarat & Ketentuan -->
    <string name="syarat_title">Syarat &amp; Ketentuan</string>
    <string name="syarat_desc_singkat">Aturan penggunaan aplikasi RuteX</string>
    <string name="syarat_1_judul">Penggunaan Aplikasi</string>
    <string name="syarat_1_isi">RuteX digunakan untuk membantu merencanakan perjalanan wisata di Cirebon. Rute, jam tiba, dan waktu tempuh yang ditampilkan adalah perkiraan, sehingga kondisi sebenarnya di lapangan bisa berbeda.</string>
    <string name="syarat_2_judul">Akun Pengguna</string>
    <string name="syarat_2_isi">Pengguna bertanggung jawab menjaga kerahasiaan kata sandi akunnya. Data yang dimasukkan saat mendaftar harus benar agar fitur seperti atur ulang kata sandi dapat berfungsi.</string>
    <string name="syarat_3_judul">Informasi Destinasi</string>
    <string name="syarat_3_isi">Jam buka, harga tiket, dan fasilitas destinasi dapat berubah sewaktu-waktu. Sebaiknya periksa kembali informasi terbaru sebelum berkunjung.</string>
    <string name="syarat_4_judul">Layanan Pihak Ketiga</string>
    <string name="syarat_4_isi">Navigasi dibuka melalui Google Maps dan peta ditampilkan dengan data OpenStreetMap. Penggunaan layanan tersebut mengikuti ketentuan masing-masing penyedia.</string>

    <!-- Kebijakan Privasi -->
    <string name="privasi_title">Kebijakan Privasi</string>
    <string name="privasi_desc_singkat">Cara RuteX mengelola datamu</string>
    <string name="privasi_1_judul">Data yang Dikumpulkan</string>
    <string name="privasi_1_isi">Saat mendaftar, RuteX meminta nama, email, nomor WhatsApp, dan kata sandi. Saat masuk dengan Google, RuteX menerima nama, email, dan foto profil dari akun Google.</string>
    <string name="privasi_2_judul">Penyimpanan Data</string>
    <string name="privasi_2_isi">Data akun dan token login disimpan di perangkat menggunakan DataStore. Rencana perjalanan disimpan di database lokal perangkat (Room) dan terhapus jika aplikasi dihapus.</string>
    <string name="privasi_3_judul">Data yang Dikirim ke Server</string>
    <string name="privasi_3_isi">Data akun email dan permintaan penyusunan rute (titik awal, destinasi, tanggal, dan jam) dikirim ke server RuteX untuk diproses.</string>
    <string name="privasi_4_judul">Menghapus Data</string>
    <string name="privasi_4_isi">Keluar dari akun akan menghapus data akun yang tersimpan di perangkat. Rencana perjalanan dapat dihapus satu per satu dari menu Riwayat.</string>

